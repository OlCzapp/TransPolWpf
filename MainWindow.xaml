<Window x:Class="TransPolWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TransPolWpf"
        mc:Ignorable="d"
        Background="AliceBlue"
        Title="MainWindow" Height="400" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <StackPanel Background="CadetBlue" Grid.RowSpan="2" Grid.Column="2" Grid.ColumnSpan="2"></StackPanel>
        
        <StackPanel Margin="10" Grid.Column="0">
            <Label Content="Marka: "></Label>
            <Label Margin="0,5,0,0" Content="Model: "></Label>
            <Label Margin="0,5,0,0" Content="Rok produkcji: "></Label>
            
            <Label Visibility="Collapsed" x:Name="liczba_drzwi_lab" Margin="0,5,0,0" Content="Liczba drzwi: "></Label>
            <Label Visibility="Collapsed" x:Name="ladownosc_lab" Margin="0,5,0,0" Content="Ładowność: "></Label>
            <Label Visibility="Collapsed" x:Name="liczba_miejsc_lab" Margin="0,5,0,0" Content="Liczba miejsc: "></Label>
        </StackPanel>

        <StackPanel Margin="10" Grid.Column="1">
            <TextBox x:Name="marka" Height="20" Margin="5"></TextBox>
            <TextBox x:Name="model" Height="20" Margin="5"></TextBox>
            <TextBox x:Name="rok_produkcji" Height="20" Margin="5"></TextBox>

            <TextBox Visibility="Collapsed" x:Name="liczba_drzwi" Height="20" Margin="5"></TextBox>
            <TextBox Visibility="Collapsed" x:Name="ladownosc" Height="20" Margin="5"></TextBox>
            <TextBox Visibility="Collapsed" x:Name="liczba_miejsc" Height="20" Margin="5"></TextBox>
        </StackPanel>

        <StackPanel Margin="10" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">
            <Label Content="Wybierz co chcesz wyświetlić:"></Label>
            <StackPanel Orientation="Horizontal">
                <RadioButton Checked="a_Checked" IsChecked="True" x:Name="a" Margin="5" Content="Osobowy"></RadioButton>
                <RadioButton Checked="b_Checked" x:Name="b" Margin="5" Content="Ciężarowy"></RadioButton>
                <RadioButton Checked="c_Checked"  x:Name="c" Margin="5" Content="Motocykl"></RadioButton>
            </StackPanel>

            <Button Click="dodaj_Click" x:Name="dodaj" FontSize="15" FontWeight="DemiBold" Background="CadetBlue" Foreground="AntiqueWhite" Width="170" Height="40" Margin="0,70,0,0" Content="Dodaj pojazd do floty"></Button>
        </StackPanel>

        <ScrollViewer Grid.RowSpan="2" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Height="330" Background="White" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBlock x:Name="wyswietlany_text" TextWrapping="Wrap" Padding="8"></TextBlock>
        </ScrollViewer>

    </Grid>
</Window>
